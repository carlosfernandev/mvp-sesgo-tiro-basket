# Python
/.venv
__pycache__/

# Node
node_modules/
dist/

# Analysis payloads: raw inputs and processed outputs stay out of git. Only the
# directory placeholders are committed, so the expected layout stays discoverable
# without versioning multi-megabyte videos or per-session result files.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
